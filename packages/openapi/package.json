{
  "name": "@voke/openapi",
  "version": "0.0.0",
  "description": "OpenAPI 3.1 documents and a Scalar API reference page for Voke routes.",
  "keywords": [
    "api-reference",
    "openapi",
    "scalar",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/openapi"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "voke": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:",
    "@voke/aws": "workspace:*",
    "@voke/schema": "workspace:*",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
