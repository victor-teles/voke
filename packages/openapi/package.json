{
  "name": "@vokejs/openapi",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 documents and a Scalar API reference page for Voke routes.",
  "keywords": [
    "api-reference",
    "openapi",
    "scalar",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/openapi"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@vokejs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsgo --project tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "bun run build && cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vokejs/aws": "workspace:*",
    "@vokejs/schema": "workspace:*",
    "voke": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "voke": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
