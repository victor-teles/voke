{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Voke stack for streams (test)",
  "Outputs": {
    "IngestClicksFunctionName": {
      "Description": "ingestClicks Lambda function name",
      "Value": {
        "Ref": "IngestClicksFunction"
      }
    },
    "ProjectOrdersFunctionName": {
      "Description": "projectOrders Lambda function name",
      "Value": {
        "Ref": "ProjectOrdersFunction"
      }
    },
    "ReportFunctionName": {
      "Description": "report Lambda function name",
      "Value": {
        "Ref": "ReportFunction"
      }
    },
    "ClicksStreamName": {
      "Description": "clicksStream name",
      "Value": {
        "Ref": "ClicksStream"
      }
    },
    "OrdersTableName": {
      "Description": "ordersTable name",
      "Value": {
        "Ref": "OrdersTable"
      }
    }
  },
  "Resources": {
    "ClicksStream": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "name",
          "Resource": "clicksStream"
        }
      },
      "Properties": {
        "StreamModeDetails": {
          "StreamMode": "ON_DEMAND"
        }
      },
      "Type": "AWS::Kinesis::Stream"
    },
    "OrdersTable": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "name",
          "Resource": "ordersTable"
        }
      },
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ],
        "StreamSpecification": {
          "StreamViewType": "NEW_AND_OLD_IMAGES"
        }
      },
      "Type": "AWS::DynamoDB::Table"
    },
    "IngestClicksFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": ["kinesis:PutRecord", "kinesis:PutRecords"],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["ClicksStream", "Arn"]
                  }
                },
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersTable", "Arn"]
                  }
                },
                {
                  "Action": [
                    "kinesis:DescribeStream",
                    "kinesis:DescribeStreamSummary",
                    "kinesis:GetRecords",
                    "kinesis:GetShardIterator",
                    "kinesis:ListShards"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["ClicksStream", "Arn"]
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "VokeResourceAccess"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "IngestClicksFunction": {
      "Metadata": {
        "VokeDeployedName": "streams-test-ingestClicks",
        "VokeEntrypoint": "./src/index.ts",
        "VokeFunction": "ingestClicks",
        "VokeInvokable": false,
        "VokeRoutes": []
      },
      "Properties": {
        "Architectures": ["arm64"],
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 501, body: \"Build and upload this Voke function before deploying.\" });"
        },
        "Environment": {
          "Variables": {
            "VOKE_RESOURCE_CLICKS_STREAM_NAME": {
              "Ref": "ClicksStream"
            },
            "VOKE_RESOURCE_ORDERS_TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "FunctionName": "streams-test-ingestClicks",
        "Handler": "index.ingestClicks",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "IngestClicksFunctionLogGroup"
          }
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": ["IngestClicksFunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 15
      },
      "Type": "AWS::Lambda::Function"
    },
    "IngestClicksFunctionLogGroup": {
      "Properties": {
        "LogGroupName": "/aws/lambda/streams-test-ingestClicks",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "IngestClicksFunctionClicksStreamEventSourceMapping": {
      "Properties": {
        "BatchSize": 100,
        "BisectBatchOnFunctionError": true,
        "Enabled": true,
        "EventSourceArn": {
          "Fn::GetAtt": ["ClicksStream", "Arn"]
        },
        "FunctionName": {
          "Ref": "IngestClicksFunction"
        },
        "FunctionResponseTypes": ["ReportBatchItemFailures"],
        "MaximumBatchingWindowInSeconds": 0,
        "StartingPosition": "TRIM_HORIZON"
      },
      "Type": "AWS::Lambda::EventSourceMapping"
    },
    "ProjectOrdersFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": ["kinesis:PutRecord", "kinesis:PutRecords"],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["ClicksStream", "Arn"]
                  }
                },
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersTable", "Arn"]
                  }
                },
                {
                  "Action": [
                    "dynamodb:DescribeStream",
                    "dynamodb:GetRecords",
                    "dynamodb:GetShardIterator"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersTable", "StreamArn"]
                  }
                },
                {
                  "Action": ["dynamodb:ListStreams"],
                  "Effect": "Allow",
                  "Resource": "*"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "VokeResourceAccess"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "ProjectOrdersFunction": {
      "Metadata": {
        "VokeDeployedName": "streams-test-projectOrders",
        "VokeEntrypoint": "./src/index.ts",
        "VokeFunction": "projectOrders",
        "VokeInvokable": false,
        "VokeRoutes": []
      },
      "Properties": {
        "Architectures": ["arm64"],
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 501, body: \"Build and upload this Voke function before deploying.\" });"
        },
        "Environment": {
          "Variables": {
            "VOKE_RESOURCE_CLICKS_STREAM_NAME": {
              "Ref": "ClicksStream"
            },
            "VOKE_RESOURCE_ORDERS_TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "FunctionName": "streams-test-projectOrders",
        "Handler": "index.projectOrders",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ProjectOrdersFunctionLogGroup"
          }
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": ["ProjectOrdersFunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 15
      },
      "Type": "AWS::Lambda::Function"
    },
    "ProjectOrdersFunctionLogGroup": {
      "Properties": {
        "LogGroupName": "/aws/lambda/streams-test-projectOrders",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "ProjectOrdersFunctionOrdersTableEventSourceMapping": {
      "Properties": {
        "BatchSize": 100,
        "BisectBatchOnFunctionError": true,
        "Enabled": true,
        "EventSourceArn": {
          "Fn::GetAtt": ["OrdersTable", "StreamArn"]
        },
        "FunctionName": {
          "Ref": "ProjectOrdersFunction"
        },
        "FunctionResponseTypes": ["ReportBatchItemFailures"],
        "MaximumBatchingWindowInSeconds": 0,
        "StartingPosition": "TRIM_HORIZON"
      },
      "Type": "AWS::Lambda::EventSourceMapping"
    },
    "ReportFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": ["kinesis:PutRecord", "kinesis:PutRecords"],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["ClicksStream", "Arn"]
                  }
                },
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersTable", "Arn"]
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "VokeResourceAccess"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "ReportFunction": {
      "Metadata": {
        "VokeDeployedName": "streams-test-report",
        "VokeEntrypoint": "./src/index.ts",
        "VokeFunction": "report",
        "VokeInvokable": true,
        "VokeRoutes": []
      },
      "Properties": {
        "Architectures": ["arm64"],
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 501, body: \"Build and upload this Voke function before deploying.\" });"
        },
        "Environment": {
          "Variables": {
            "VOKE_RESOURCE_CLICKS_STREAM_NAME": {
              "Ref": "ClicksStream"
            },
            "VOKE_RESOURCE_ORDERS_TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "FunctionName": "streams-test-report",
        "Handler": "index.report",
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ReportFunctionLogGroup"
          }
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": ["ReportFunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 15
      },
      "Type": "AWS::Lambda::Function"
    },
    "ReportFunctionLogGroup": {
      "Properties": {
        "LogGroupName": "/aws/lambda/streams-test-report",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    }
  }
}
