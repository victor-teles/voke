{
  "name": "@voke/aws",
  "version": "0.1.0",
  "description": "The AWS Provider for Voke: CloudFormation synthesis, Lambda handlers, deploy, local AWS and diagnostics.",
  "keywords": [
    "aws",
    "cloudformation",
    "lambda",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/aws"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "imports": {
    "#provider": {
      "voke-runtime": "./src/provider-runtime.ts",
      "@voke/source": "./src/provider.ts",
      "types": "./dist/provider.d.ts",
      "default": "./src/provider.ts"
    }
  },
  "exports": {
    ".": {
      "@voke/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./cloudformation": {
      "@voke/source": "./src/cloudformation.ts",
      "types": "./dist/cloudformation.d.ts",
      "default": "./src/cloudformation.ts"
    },
    "./local": {
      "@voke/source": "./src/local.ts",
      "types": "./dist/local.d.ts",
      "default": "./src/local.ts"
    },
    "./testing": {
      "@voke/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsgo --project tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "bun run build && cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1053.0",
    "@aws-sdk/client-lambda": "^3.1050.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-secrets-manager": "^3.1053.0",
    "@aws-sdk/client-ssm": "^3.1053.0",
    "@aws/durable-execution-sdk-js": "^3.0.0",
    "@aws/durable-execution-sdk-js-testing": "^1.3.2",
    "@voke/build": "workspace:*",
    "@voke/http": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "hono": "^4.0.0",
    "voke": "workspace:*"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "voke": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
