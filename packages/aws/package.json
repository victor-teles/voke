{
  "name": "@voke/aws",
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cloudformation": "./src/cloudformation.ts",
    "./local": "./src/local.ts",
    "./testing": "./src/testing.ts"
