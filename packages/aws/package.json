{
  "name": "@voke/aws",
  "version": "0.0.0",
  "description": "The AWS Provider for Voke: CloudFormation synthesis, Lambda handlers, deploy, local AWS and diagnostics.",
  "keywords": [
    "aws",
    "cloudformation",
    "lambda",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/aws"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cloudformation": "./src/cloudformation.ts",
    "./local": "./src/local.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1053.0",
    "@aws-sdk/client-lambda": "^3.1050.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-secrets-manager": "^3.1053.0",
    "@aws-sdk/client-ssm": "^3.1053.0",
    "@voke/build": "workspace:*",
    "@voke/http": "workspace:*",
    "hono": "^4.0.0",
    "voke": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
