{
  "name": "@voke/idempotency",
  "version": "0.0.0",
  "description": "A Voke Plugin that makes a retried handler run once, backed by a DynamoDB table it provisions.",
  "keywords": [
    "aws",
    "dynamodb",
    "idempotency",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/idempotency"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1053.0",
    "@voke/aws": "workspace:*",
    "voke": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:",
    "@voke/http": "workspace:*",
    "@voke/schema": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
