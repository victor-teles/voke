{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "strictNullChecks": true,
    // Core tests exercise the split @vokejs/* packages, which depend on core.
    // Declaring them as dependencies would create a workspace cycle, so tests
    // resolve them from source instead (Bun honors these paths at runtime).
    "paths": {
      "@vokejs/aws": ["../aws/src/index.ts"],
      "@vokejs/aws/*": ["../aws/src/*.ts"],
      "@vokejs/build": ["../build/src/index.ts"],
      "@vokejs/http": ["../http/src/index.ts"],
      "@vokejs/openapi": ["../openapi/src/index.ts"],
      "@vokejs/idempotency": ["../idempotency/src/index.ts"],
      "@vokejs/remote": ["../remote/src/index.ts"],
      "@vokejs/schema": ["../schema/src/index.ts"],
      "@vokejs/testing": ["../testing/src/index.ts"]
    }
  }
}
