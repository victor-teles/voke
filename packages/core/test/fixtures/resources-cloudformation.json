{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Voke stack for orders-api (prod)",
  "Outputs": {
    "ApiUrl": {
      "Description": "HTTP API URL",
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.amazonaws.com/prod"
      }
    },
    "FunctionName": {
      "Description": "api Lambda function name",
      "Value": {
        "Ref": "Function"
      }
    },
    "EventsQueueUrl": {
      "Description": "eventsQueue url",
      "Value": {
        "Ref": "EventsQueue"
      }
    },
    "OrdersTableName": {
      "Description": "ordersTable name",
      "Value": {
        "Ref": "OrdersTable"
      }
    }
  },
  "Resources": {
    "EventsQueue": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "url",
          "Resource": "eventsQueue"
        }
      },
      "Properties": {},
      "Type": "AWS::SQS::Queue"
    },
    "OrdersTable": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "name",
          "Resource": "ordersTable"
        }
      },
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ]
      },
      "Type": "AWS::DynamoDB::Table"
    },
    "FunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["EventsQueue", "Arn"]
                  }
                },
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:Scan"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersTable", "Arn"]
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "VokeResourceAccess"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "Function": {
      "Metadata": {
        "VokeDeployedName": "orders-api-prod",
        "VokeEntrypoint": "./src/index.ts",
        "VokeFunction": "api",
        "VokeInvokable": false,
        "VokeRoutes": ["$default"]
      },
      "Properties": {
        "Code": {
          "ZipFile": "export const handler = async () => ({ statusCode: 501, body: 'Build and upload this Voke function before deploying.' });"
        },
        "Environment": {
          "Variables": {
            "LOG_LEVEL": "info",
            "VOKE_RESOURCE_EVENTS_QUEUE_URL": {
              "Ref": "EventsQueue"
            },
            "VOKE_RESOURCE_ORDERS_TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "FunctionName": "orders-api-prod",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": ["FunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x"
      },
      "Type": "AWS::Lambda::Function"
    },
    "Api": {
      "Properties": {
        "Name": "orders-api-prod",
        "ProtocolType": "HTTP"
      },
      "Type": "AWS::ApiGatewayV2::Api"
    },
    "Integration": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": ["Function", "Arn"]
        },
        "PayloadFormatVersion": "2.0"
      },
      "Type": "AWS::ApiGatewayV2::Integration"
    },
    "Route": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      },
      "Type": "AWS::ApiGatewayV2::Route"
    },
    "Stage": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "AutoDeploy": true,
        "StageName": "prod"
      },
      "Type": "AWS::ApiGatewayV2::Stage"
    },
    "Permission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/*"
        }
      },
      "Type": "AWS::Lambda::Permission"
    }
  }
}
