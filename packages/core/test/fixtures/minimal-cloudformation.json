{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Voke stack for snapshot-api (test)",
  "Outputs": {
    "ApiUrl": {
      "Description": "HTTP API URL",
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.amazonaws.com"
      }
    },
    "FunctionName": {
      "Description": "http Lambda function name",
      "Value": {
        "Ref": "Function"
      }
    }
  },
  "Resources": {
    "FunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "Function": {
      "Metadata": {
        "VokeDeployedName": "snapshot-api-test-http",
        "VokeEntrypoint": "./src/index.ts",
        "VokeFunction": "http",
        "VokeInvokable": false,
        "VokeRoutes": ["GET /health"]
      },
      "Properties": {
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 501, body: \"Build and upload this Voke function before deploying.\" });"
        },
        "Environment": {
          "Variables": {}
        },
        "FunctionName": "snapshot-api-test-http",
        "Handler": "index.http",
        "Role": {
          "Fn::GetAtt": ["FunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x"
      },
      "Type": "AWS::Lambda::Function"
    },
    "Api": {
      "Properties": {
        "Name": "snapshot-api-test",
        "ProtocolType": "HTTP"
      },
      "Type": "AWS::ApiGatewayV2::Api"
    },
    "HttpIntegration": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": ["Function", "Arn"]
        },
        "PayloadFormatVersion": "2.0"
      },
      "Type": "AWS::ApiGatewayV2::Integration"
    },
    "HttpGETHealthRoute": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "GET /health",
        "Target": {
          "Fn::Sub": "integrations/${HttpIntegration}"
        }
      },
      "Type": "AWS::ApiGatewayV2::Route"
    },
    "Stage": {
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "AutoDeploy": true,
        "StageName": "$default"
      },
      "Type": "AWS::ApiGatewayV2::Stage"
    },
    "Permission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/*"
        }
      },
      "Type": "AWS::Lambda::Permission"
    }
  }
}
