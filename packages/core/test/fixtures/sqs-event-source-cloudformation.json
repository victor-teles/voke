{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Voke stack for orders-worker (prod)",
  "Outputs": {
    "ProcessOrdersFunctionName": {
      "Description": "processOrders Lambda function name",
      "Value": {
        "Ref": "ProcessOrdersFunction"
      }
    },
    "OrdersQueueUrl": {
      "Description": "ordersQueue url",
      "Value": {
        "Ref": "OrdersQueue"
      }
    },
    "PriorityQueueUrl": {
      "Description": "priorityQueue url",
      "Value": {
        "Ref": "PriorityQueue"
      }
    }
  },
  "Resources": {
    "OrdersQueue": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "url",
          "Resource": "ordersQueue"
        }
      },
      "Properties": {
        "VisibilityTimeout": 90
      },
      "Type": "AWS::SQS::Queue"
    },
    "PriorityQueue": {
      "Metadata": {
        "VokeBinding": {
          "Attribute": "url",
          "Resource": "priorityQueue"
        }
      },
      "Properties": {
        "VisibilityTimeout": 120
      },
      "Type": "AWS::SQS::Queue"
    },
    "ProcessOrdersFunctionRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["OrdersQueue", "Arn"]
                  }
                },
                {
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": ["PriorityQueue", "Arn"]
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "VokeResourceAccess"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "ProcessOrdersFunction": {
      "Metadata": {
        "VokeDeployedName": "orders-worker-prod-processOrders",
        "VokeEntrypoint": "./src/functions/process-orders.ts",
        "VokeFunction": "processOrders",
        "VokeInvokable": false,
        "VokeRoutes": []
      },
      "Properties": {
        "Code": {
          "ZipFile": "exports.handler = async () => ({ statusCode: 501, body: \"Build and upload this Voke function before deploying.\" });"
        },
        "Environment": {
          "Variables": {
            "VOKE_RESOURCE_ORDERS_QUEUE_URL": {
              "Ref": "OrdersQueue"
            },
            "VOKE_RESOURCE_PRIORITY_QUEUE_URL": {
              "Ref": "PriorityQueue"
            }
          }
        },
        "FunctionName": "orders-worker-prod-processOrders",
        "Handler": "process-orders.handler",
        "Architectures": ["arm64"],
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ProcessOrdersFunctionLogGroup"
          }
        },
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": ["ProcessOrdersFunctionRole", "Arn"]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 15
      },
      "Type": "AWS::Lambda::Function"
    },
    "ProcessOrdersFunctionLogGroup": {
      "Properties": {
        "LogGroupName": "/aws/lambda/orders-worker-prod-processOrders",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "ProcessOrdersFunctionOrdersQueueEventSourceMapping": {
      "Properties": {
        "BatchSize": 10,
        "Enabled": true,
        "EventSourceArn": {
          "Fn::GetAtt": ["OrdersQueue", "Arn"]
        },
        "FunctionName": {
          "Ref": "ProcessOrdersFunction"
        },
        "FunctionResponseTypes": ["ReportBatchItemFailures"],
        "MaximumBatchingWindowInSeconds": 0
      },
      "Type": "AWS::Lambda::EventSourceMapping"
    },
    "ProcessOrdersFunctionPriorityQueueEventSourceMapping": {
      "Properties": {
        "BatchSize": 5,
        "Enabled": false,
        "EventSourceArn": {
          "Fn::GetAtt": ["PriorityQueue", "Arn"]
        },
        "FunctionName": {
          "Ref": "ProcessOrdersFunction"
        },
        "FunctionResponseTypes": ["ReportBatchItemFailures"],
        "MaximumBatchingWindowInSeconds": 30
      },
      "Type": "AWS::Lambda::EventSourceMapping"
    }
  }
}
