{
  "name": "voke",
  "version": "0.0.0",
  "bin": {
    "voke": "./src/cli.ts"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun",
