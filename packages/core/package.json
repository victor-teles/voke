    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1050.0",
    "@aws-sdk/client-secrets-manager": "^3.1053.0",
    "@aws-sdk/client-ssm": "^3.1053.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:",
    "hono": "^4.0.0"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  }
}
