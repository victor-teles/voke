{
  "name": "voke",
  "version": "0.0.0",
  "description": "A TypeScript-first framework for AWS Lambda APIs: Functions, a Gateway, typed contracts and one-command deploys.",
  "keywords": [
    "api",
    "aws",
    "bun",
    "framework",
    "lambda",
    "serverless"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/core"
  },
  "bin": {
    "voke": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun",
    "test": "bun test",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "cp ../../LICENSE ../../README.md .",
    "postpack": "rm -f LICENSE README.md"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:",
    "hono": "^4.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
