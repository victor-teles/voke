{
  "name": "@voke/schema",
  "version": "0.1.0",
  "description": "Standard Schema helpers for Voke Function Contracts.",
  "keywords": [
    "schema",
    "validation",
    "voke"
  ],
  "homepage": "https://github.com/victor-teles/voke#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victor-teles/voke",
    "directory": "packages/schema"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@voke/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsgo --project tsconfig.build.json",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bunx tsgo --project tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage",
    "prepack": "bun run build && cp ../../LICENSE .",
    "postpack": "rm -f LICENSE"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "voke": "workspace:*"
  },
  "peerDependencies": {
    "voke": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
