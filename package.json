{
  "name": "voke-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "release:check": "bun run check && bun run typecheck && bun run test && bun test ./scripts && bun run smoke:pack",
    "smoke:pack": "bun scripts/pack-smoke.ts",
    "clean": "turbo run clean",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "turbo": "catalog:",
    "ultracite": "7.7.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@types/bun": "^1.4.4",
    "@typescript/native-preview": "^7.0.0-dev.20260516.1",
    "turbo": "^2.9.14"
  }
}
