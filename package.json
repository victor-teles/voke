{
  "name": "voke-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "release:check": "bun run typecheck && bun test",
    "clean": "turbo run clean",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native-preview": "catalog:",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "turbo": "latest",
    "ultracite": "7.7.0"
  },
  "packageManager": "bun@1.3.11",
  "catalog": {
    "@typescript/native-preview": "^7.0.0-dev.20260516.1"
  }
}
